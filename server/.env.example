# ============================================
# Servidor
# ============================================
PORT=3001
NODE_ENV=development

# ============================================
# Banco de dados MySQL
# ============================================
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASS=senha_aqui
DB_NAME=anstartup

# ============================================
# JWT
# ============================================
JWT_ACCESS_SECRET=troque_por_uma_string_secreta_longa_aqui
JWT_REFRESH_SECRET=troque_por_outra_string_secreta_aqui
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ============================================
# Frontend (CORS)
# ============================================
FRONTEND_URL=http://localhost:5173

# ============================================
# Email (SMTP)
# ============================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=seu@email.com
SMTP_PASS=senha_app_aqui
EMAIL_FROM=ANSTARTUP Brasil <noreply@anstartup.com.br>

# ============================================
# Cookies
# ============================================
COOKIE_DOMAIN=localhost
